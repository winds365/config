#!/sbin/openrc-run

name="Xray Daemon"
description="A unified platform for anti-censorship"

supervisor=supervise-daemon
respawn_delay=5
respawn_max=5
respawn_period=600

env=${env:-"XRAY_LOCATION_ASSET=/usr/local/share/xray/"}
command="/usr/local/bin/xray"
command_user="nobody:nobody"
command_args="run -confdir /etc/xray"

rc_ulimit="-n 65535"
capabilities="^cap_net_bind_service,^cap_net_admin,^cap_net_raw"
umask="027"
extra_commands="checkconfig"

depend() {
	need net
}

start_pre() {
    checkpath --directory --owner nobody:nobody --mode 0755 /var/log/xray
    checkconfig || return 1
}

checkconfig() {
    ebegin "Checking Xray configuration"
    export XRAY_LOCATION_ASSET="/usr/local/share/xray"
	su ${command_user%:*} -s /bin/sh -c "$command $command_args -test"
	eend $?
}