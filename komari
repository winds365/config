#!/sbin/openrc-run

name="komari"
description="Komari Monitor Service"

command="/etc/komari/komari"
command_args="server -l 0.0.0.0:25774"

directory="/etc/komari"

supervisor=supervise-daemon

command_background="yes"

output_log="/var/log/komari/komari_access.log"
error_log="/var/log/komari/komari_error.log"

depend() {
    need net
}